# ── Kader — local development environment ──────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# These map 1:1 to `runtimeConfig` in nuxt.config.ts and server code.

# Supabase
NUXT_PUBLIC_SUPABASE_URL=<your-supabase-url>          # e.g. https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key> # anon / publishable (client-safe)
NUXT_SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>  # server-only, NEVER expose client-side

# Pretix
NUXT_PRETIX_WEBHOOK_SECRET=<your-pretix-webhook-secret> # HMAC secret set in the Pretix webhook
NUXT_PUBLIC_PRETIX_URL=https://pretix.eu                # base URL for the Pretix ticket widget

# Telegram Bot (staff alerts — server-only)
NUXT_TELEGRAM_BOT_TOKEN=                                # from @BotFather on Telegram
NUXT_TELEGRAM_CHAT_ID=                                  # staff group chat ID

# ── Resident Advisor sync (scripts/sync-ra.mjs — local / CI only, NOT the app) ──
# These are read directly by the script, not Nuxt. Used for a local one-off run.
RA_CLUB_ID=78778
RA_LIMIT=200
SUPABASE_URL=<your-supabase-url>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
